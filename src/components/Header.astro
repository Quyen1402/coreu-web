---
import Logo from './Logo.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
const nav = [
  { href: '/khoa-hoc', label: 'Khoá học' },
  { href: '/ve-coreu', label: 'Về CoreU' },
  { href: site.skoolUrl, label: 'Cộng đồng', external: true },
];
---
<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label="CoreU — Trang chủ"><Logo /></a>
    <nav class="hdr__nav" id="nav" aria-label="Chính">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}
          {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}>{n.label}</a>
      ))}
      <a href="/khoa-hoc" class="btn btn--primary btn--sm hdr__cta">Bắt đầu học</a>
    </nav>
    <button class="hdr__burger" aria-controls="nav" aria-expanded="false" aria-label="Mở menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>
<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const onScroll = () => hdr.classList.toggle('is-scrolled', scrollY > 12);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  burger.addEventListener('click', () => {
    const open = hdr.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; transition: background 0.3s, box-shadow 0.3s; }
  .hdr.is-scrolled { background: rgba(255, 255, 255, 0.82); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); box-shadow: 0 1px 0 var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .hdr__nav { display: flex; align-items: center; gap: 34px; font-size: 0.925rem; font-weight: 500; }
  .hdr__nav > a:not(.btn) { color: var(--ink-2); position: relative; transition: color 0.2s; }
  .hdr__nav > a:not(.btn):hover, .hdr__nav > a[aria-current] { color: var(--ink); }
  .hdr__nav > a[aria-current]::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--coreu-tech-blue); border-radius: 2px; }
  .hdr__burger { display: none; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; position: relative; }
  .hdr__burger span { position: absolute; left: 11px; right: 11px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.35s var(--ease); }
  .hdr__burger span:first-child { top: 17px; } .hdr__burger span:last-child { top: 25px; }
  .is-open .hdr__burger span:first-child { transform: translateY(4px) rotate(45deg); }
  .is-open .hdr__burger span:last-child { transform: translateY(-4px) rotate(-45deg); }
  @media (max-width: 820px) {
    .hdr__burger { display: block; z-index: 2; }
    .hdr__nav {
      position: fixed; inset: 0; flex-direction: column; justify-content: center; gap: 28px;
      background: #fff; font-size: 1.5rem; font-weight: 600;
      opacity: 0; pointer-events: none; transition: opacity 0.35s var(--ease);
    }
    .is-open .hdr__nav { opacity: 1; pointer-events: auto; }
    .hdr__cta { --h: 54px; font-size: 1rem; }
  }
</style>
