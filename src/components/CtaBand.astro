---
import Arrow from './Arrow.astro';
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Hành trình nào cũng bắt đầu từ một bước.',
  text = 'Chọn một khoá học, vào cộng đồng, và bắt đầu tiến đến toàn diện cùng CoreU.',
  href = '/khoa-hoc',
  label = 'Chọn khoá học của bạn',
} = Astro.props;
---
<section class="cta">
  <div class="wrap">
    <div class="cta__box reveal">
      <h2 class="h2">{title}</h2>
      <p class="lead">{text}</p>
      <a href={href} class="btn btn--light">{label} <Arrow /></a>
    </div>
  </div>
</section>
<style>
  .cta { padding: 0 0 clamp(72px, 10vw, 120px); }
  .cta__box { position: relative; overflow: hidden; display: grid; gap: 22px; justify-items: start; padding: clamp(40px, 7vw, 88px); border-radius: 28px; background: var(--coreu-gradient); color: #fff; }
  .cta__box::after { content: ''; position: absolute; right: -120px; bottom: -160px; width: 460px; height: 460px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.25); box-shadow: 0 0 0 60px rgba(255, 255, 255, 0.05), 0 0 0 120px rgba(255, 255, 255, 0.03); pointer-events: none; }
  .cta .lead { color: rgba(255, 255, 255, 0.82); }
  .cta .h2 { max-width: 18ch; }
</style>
